# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (import script, seeding). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web app (safe to expose: the anon key is public, row-level security protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
